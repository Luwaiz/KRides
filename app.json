{
  "expo": {
    "name": "KRides",
    "slug": "KRides",
    "owner": "uwaiz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splashscreen_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow KRides to access your photos to update your profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "color": "#0066F5"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "61bd7aca-e58d-4cf2-840c-28773922c9d1"
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.eluwaiz.KRides",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "ios": {
      "bundleIdentifier": "com.eluwaiz.KRides",
      "buildNumber": "1.0.0",
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "googleMapsApiKey": ""
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "KRides needs your location to find nearby drivers and calculate routes.",
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  }
}
