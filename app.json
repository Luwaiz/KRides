{
  "expo": {
    "name": "KRides",
    "slug": "KRides",
    "owner": "eluwaiz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splashscreen_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "8bd3366e-c67f-4c79-a093-e409ebb147f4"
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.eluwaiz.KRides",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB7fe6OfWqZs2BP0AoZS-2jLi5mIVbiYTM"
        }
      }
    },
    "ios": {
      "bundleIdentifier": "com.eluwaiz.KRides",
      "buildNumber": "1.0.0",
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "googleMapsApiKey": "AIzaSyB59DSubzPcNuQkfYrNv_pfhBtJX_rqPI4"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "KRides needs your location to find nearby drivers and calculate routes.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "KRides needs your location to track rides and show driver arrival.",
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  }
}
