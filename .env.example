# KRides Environment Variables
# Copy this file to .env and fill in your actual values

# API URLs
API_URL=https://krides.olaoluwaeyeclinic.com/api
DEV_API_URL=https://krides.olaoluwaeyeclinic.com/api

# Firebase Configuration
FIREBASE_API_KEY=AIzaSyA2EsyMXZlABPA1ZJ06Y9S6VOsKR62EQkA
FIREBASE_AUTH_DOMAIN=kampusride.firebaseapp.com
FIREBASE_PROJECT_ID=kampusride
FIREBASE_STORAGE_BUCKET=kampusride.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=1054058095059
FIREBASE_APP_ID=1:1054058095059:web:ff2a3c61ad63d32d818f26
FIREBASE_MEASUREMENT_ID=G-GJK6Q51CPP

# Google Maps API Key — also set in EAS build env or as EAS Secret
# Restrict this key in Google Cloud Console to your app's package name + SHA-1
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Flutterwave public key (safe to commit — public key only)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your-public-key-here
# NOTE: FLUTTERWAVE_SECRET_KEY must NEVER go in the client app.
# It belongs only in notification-server/.env

# Notification server shared secret — must match NOTIFICATION_API_KEY on the server
# Generate with: openssl rand -hex 32
NOTIFICATION_API_KEY=your-strong-random-secret-here
