# KRides Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit your real .env — it is gitignored.

# API URLs
API_URL=https://your-api-host.example.com/api
DEV_API_URL=https://your-api-host.example.com/api

# Firebase Configuration
# Find these in Firebase Console → Project Settings → General → Your apps.
# These are client-side identifiers (semi-public by design), but keep real
# values out of version control as a matter of hygiene.
FIREBASE_API_KEY=your-firebase-api-key-here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id

# Google OAuth web client ID (from Firebase / Google Cloud Console)
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Google Maps API Key — also set in EAS build env or as an EAS Secret.
# Restrict this key in Google Cloud Console to your app's package name + SHA-1.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Flutterwave public key (public key only — safe on the client).
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your-public-key-here
# NOTE: FLUTTERWAVE_SECRET_KEY must NEVER go in the client app.
# It belongs only in notification-server/.env

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# Notification server shared secret — must match NOTIFICATION_API_KEY on the server.
# Generate with: openssl rand -hex 32
NOTIFICATION_API_KEY=your-strong-random-secret-here
