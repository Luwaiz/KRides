--- a/node_modules/react-native/React/Fabric/Mounting/ComponentViews/Modal/RCTModalHostViewComponentView.mm
+++ b/node_modules/react-native/React/Fabric/Mounting/ComponentViews/Modal/RCTModalHostViewComponentView.mm
@@ -133,8 +133,73 @@ static ModalHostViewEventEmitter::OnOrientationChange onOrientationChangeStruct(
                      animated:(BOOL)animated
                    completion:(void (^)(void))completion
 {
+  // iOS 26 throws "_presentViewController inside _runAlongsideCompletions" -> SIGABRT
+  // when presentViewController: is called while ANY view controller in the presenter's
+  // hierarchy has an active transitionCoordinator. iOS 26 registers the call as an alongside
+  // completion block; when the coordinator's transition ends, that block fires inside
+  // _runAlongsideCompletions and crashes.
+  //
+  // A single dispatch_async only delays one run-loop cycle (~16ms); active transitions
+  // run for ~350ms. We must keep deferring until every coordinator on the presenter chain
+  // (and on the topmost presented VC) is clear, then call presentViewController: in a clean
+  // run-loop tick that is past _runAlongsideCompletions.
   UIViewController *controller = [self reactViewController];
-  [controller presentViewController:modalViewController animated:animated completion:completion];
+  [self _RCTKR_attemptPresent:modalViewController
+                           on:controller
+                     animated:animated
+                   completion:completion
+                     attempts:0];
+}
+
+- (void)_RCTKR_attemptPresent:(UIViewController *)modalViewController
+                           on:(UIViewController *)controller
+                     animated:(BOOL)animated
+                   completion:(void (^)(void))completion
+                     attempts:(NSInteger)attempts
+{
+  __weak RCTModalHostViewComponentView *weakSelf = self;
+  __weak UIViewController *weakController = controller;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    RCTModalHostViewComponentView *strongSelf = weakSelf;
+    UIViewController *strongController = weakController;
+    if (!strongSelf || !strongController || !strongSelf->_isPresented) {
+      return;
+    }
+
+    // Walk the presenter's parent chain (catches navigation-controller push/pop).
+    BOOL hasActiveCoordinator = NO;
+    UIViewController *vc = strongController;
+    while (vc != nil) {
+      if (vc.transitionCoordinator != nil) {
+        hasActiveCoordinator = YES;
+        break;
+      }
+      vc = vc.parentViewController;
+    }
+    // Also walk down the presented chain (catches an in-flight foreign modal dismiss).
+    if (!hasActiveCoordinator) {
+      UIViewController *presented = strongController.presentedViewController;
+      while (presented != nil) {
+        if (presented.transitionCoordinator != nil) {
+          hasActiveCoordinator = YES;
+          break;
+        }
+        presented = presented.presentedViewController;
+      }
+    }
+
+    if (hasActiveCoordinator && attempts < 60) {
+      // ~16ms per retry, max ~960ms wait — long enough for any UIKit modal/nav transition.
+      [strongSelf _RCTKR_attemptPresent:modalViewController
+                                     on:strongController
+                               animated:animated
+                             completion:completion
+                               attempts:attempts + 1];
+      return;
+    }
+
+    [strongController presentViewController:modalViewController animated:animated completion:completion];
+  });
 }
 
