rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isRatingUpdate() {
      return request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['ratings', 'totalRatings', 'ratingSum']);
    }

    // ── Users (customers) ─────────────────────────────────────────────────────
    match /users/{userId} {
      // Users read and write only their own document.
      // Push-token lookup for customers happens server-side (Admin SDK) so
      // cross-user reads are no longer needed here.
      allow read:   if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // ── Drivers ───────────────────────────────────────────────────────────────
    match /drivers/{driverId} {
      // Only the driver reads their own document.
      // Phone-to-email lookup for login now runs server-side via Admin SDK
      // (POST /api/auth/driver-email on the notification server), so the
      // public read that was previously required here is no longer needed.
      allow read:   if isOwner(driverId);
      allow create: if isOwner(driverId);
      // Driver updates own profile; authenticated customers write rating fields only.
      allow update: if isOwner(driverId) || (isAuth() && isRatingUpdate());
      allow delete: if false;
    }

    // ── Rides ─────────────────────────────────────────────────────────────────
    match /rides/{rideId} {
      // Create: only the customer who will own the ride.
      allow create: if isAuth()
                    && request.resource.data.customerId == request.auth.uid;

      // Read:
      //   • The customer who booked the ride.
      //   • The assigned driver.
      //   • Any authenticated driver may read a pending ride to decide whether
      //     to accept it (only status == 'pending' exposed at this stage).
      allow read: if isAuth() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId   == request.auth.uid ||
        resource.data.status     == 'pending'
      );

      // Update:
      //   • Customer cancels their own ride.
      //   • Assigned driver updates ride progress.
      //   • Any authenticated driver may accept an unassigned pending ride
      //     (sets driverId = themselves, status = 'accepted').
      //   • Any authenticated driver may add themselves to declined_by.
      allow update: if isAuth() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId   == request.auth.uid ||
        (
          resource.data.status == 'pending' &&
          (resource.data.driverId == null || resource.data.driverId == '') &&
          request.resource.data.driverId == request.auth.uid &&
          request.resource.data.status   == 'accepted'
        ) ||
        (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['declined_by']) &&
          request.resource.data.declined_by is list
        )
      );

      // Only the booking customer may delete a ride.
      allow delete: if isAuth()
                    && resource.data.customerId == request.auth.uid;
    }

    // ── Driver locations ──────────────────────────────────────────────────────
    match /driver_locations/{driverId} {
      allow read:  if isAuth();
      allow write: if isOwner(driverId);
    }

    // ── Pickup / dropoff suggestions (admin-managed) ──────────────────────────
    match /locations/{locationId} {
      allow read:  if isAuth();
      allow write: if false;
    }

    // ── Catch-all: deny everything not listed above ───────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}