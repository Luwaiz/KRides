rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Money, payout, refund and verification fields are written only by the
    // notification server (Admin SDK, which bypasses these rules). The server trusts
    // them, so clients must never be able to change them.

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function driverProtectedFields() {
      return ['bankDetailsVerified', 'bankCode', 'accountNumber', 'accountName', 'bankName',
              'subaccountId', 'subaccountCreatedAt', 'ratings', 'totalPaidOut', 'createdByAdmin'];
    }

    function hasVerifiedBankDetails() {
      return get(/databases/$(database)/documents/drivers/$(request.auth.uid))
               .data.bankDetailsVerified == true;
    }

    match /users/{userId} {
      allow read:   if isOwner(userId);
      allow create: if isOwner(userId) && !('walletBalance' in request.resource.data);
      allow update: if isOwner(userId) && !changedKeys().hasAny(['walletBalance']);
      allow delete: if false;
    }

    match /users/{userId}/walletTransactions/{txnId} {
      allow read:  if isOwner(userId);
      allow write: if false;
    }

    match /drivers/{driverId} {
      allow read:   if isOwner(driverId);
      allow create: if isOwner(driverId) && !request.resource.data.keys().hasAny(driverProtectedFields());
      allow update: if isOwner(driverId) && !changedKeys().hasAny(driverProtectedFields());
      allow delete: if false;
    }

    match /rides/{rideId} {
      // Rides are created by the server after payment is verified
      // (POST /api/rides/create for card, /api/wallet/pay-ride for wallet).
      allow create: if false;

      allow read: if isAuth() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId   == request.auth.uid ||
        (resource.data.status == 'pending' && hasVerifiedBankDetails())
      );

      allow update: if isAuth() && (
        // A verified driver accepts a pending ride.
        (
          resource.data.status == 'pending' &&
          (resource.data.driverId == null || resource.data.driverId == '') &&
          request.resource.data.driverId == request.auth.uid &&
          request.resource.data.status   == 'accepted' &&
          changedKeys().hasOnly(['status', 'driverId', 'driverName', 'driverPhone', 'vehicleId', 'acceptedAt']) &&
          hasVerifiedBankDetails()
        ) ||
        // The assigned driver marks arrival. Completion and cancellation go through the server.
        (
          resource.data.driverId == request.auth.uid &&
          resource.data.status in ['accepted', 'in_progress'] &&
          request.resource.data.status == 'in_progress' &&
          changedKeys().hasOnly(['status', 'hasArrived', 'arrivedAt'])
        ) ||
        // A driver declines a pending ride: only their own UID may be appended.
        (
          changedKeys().hasOnly(['declined_by']) &&
          request.resource.data.declined_by is list &&
          request.resource.data.declined_by.hasAll(resource.data.declined_by) &&
          request.resource.data.declined_by.size() == resource.data.declined_by.size() + 1 &&
          request.resource.data.declined_by.hasAll([request.auth.uid]) &&
          !resource.data.declined_by.hasAll([request.auth.uid])
        )
      );

      allow delete: if false;
    }

    match /driver_locations/{driverId} {
      allow read:  if isOwner(driverId) ||
                      (isAuth() && resource.data.activeRideCustomerId == request.auth.uid);
      allow write: if isOwner(driverId);
    }

    match /locations/{locationId} {
      allow read:  if isAuth();
      allow write: if false;
    }

    match /config/{configId} {
      allow read:  if isAuth();
      allow write: if false;
    }

    match /orphanedCharges/{chargeId} {
      allow create: if isAuth() && request.resource.data.customerId == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /orphanedTopups/{topupId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
