rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isRatingUpdate() {
      return request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['ratings', 'totalRatings', 'ratingSum']);
    }

    // Guard against oversized string fields written to ride documents.
    function rideFieldLengthsOk() {
      let d = request.resource.data;
      return (!('customerName'   in d) || (d.customerName   is string && d.customerName.size()   <= 100)) &&
             (!('customerPhone'  in d) || (d.customerPhone  is string && d.customerPhone.size()  <=  20)) &&
             (!('pickupLocation' in d) || (d.pickupLocation is string && d.pickupLocation.size() <= 200)) &&
             (!('destination'    in d) || (d.destination    is string && d.destination.size()    <= 200));
    }

    // ── Users (customers) ─────────────────────────────────────────────────────
    match /users/{userId} {
      // Users read and write only their own document.
      // Push-token lookup for customers happens server-side (Admin SDK) so
      // cross-user reads are no longer needed here.
      // Wallet balance and virtual account fields are written server-side only
      // (Admin SDK bypasses these rules), so no special client write rule needed.
      allow read:   if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // ── Wallet transactions (customers) ──────────────────────────────────────
    match /users/{userId}/walletTransactions/{txnId} {
      // Customer reads their own transaction history.
      // All writes are performed server-side via Admin SDK (webhook handler).
      allow read:  if isOwner(userId);
      allow write: if false;
    }

    // ── Drivers ───────────────────────────────────────────────────────────────
    match /drivers/{driverId} {
      // Only the driver reads their own document.
      // Phone-to-email lookup for login now runs server-side via Admin SDK
      // (POST /api/auth/driver-email on the notification server), so the
      // public read that was previously required here is no longer needed.
      allow read:   if isOwner(driverId);
      allow create: if isOwner(driverId);
      // Driver updates own profile; authenticated customers write rating fields only.
      allow update: if isOwner(driverId) || (isAuth() && isRatingUpdate());
      allow delete: if false;
    }

    // ── Rides ─────────────────────────────────────────────────────────────────
    match /rides/{rideId} {
      // Create: only the customer who will own the ride, with sane field lengths.
      allow create: if isAuth()
                    && request.resource.data.customerId == request.auth.uid
                    && rideFieldLengthsOk();

      // Read:
      //   • The customer who booked the ride.
      //   • The assigned driver.
      //   • Any registered driver may read a pending ride to decide whether
      //     to accept it — existence check prevents non-drivers from polling.
      allow read: if isAuth() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId   == request.auth.uid ||
        (
          resource.data.status == 'pending' &&
          exists(/databases/$(database)/documents/drivers/$(request.auth.uid))
        )
      );

      // Update:
      //   • Customer cancels their own ride.
      //   • Assigned driver updates ride progress.
      //   • Any authenticated driver may accept an unassigned pending ride
      //     (sets driverId = themselves, status = 'accepted').
      //   • Any authenticated driver may add themselves to declined_by.
      allow update: if isAuth() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId   == request.auth.uid ||
        (
          resource.data.status == 'pending' &&
          (resource.data.driverId == null || resource.data.driverId == '') &&
          request.resource.data.driverId == request.auth.uid &&
          request.resource.data.status   == 'accepted'
        ) ||
        (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['declined_by']) &&
          request.resource.data.declined_by is list &&
          request.resource.data.declined_by.hasAll(resource.data.declined_by) &&
          request.resource.data.declined_by.size() == resource.data.declined_by.size() + 1 &&
          request.resource.data.declined_by.hasAll([request.auth.uid]) &&
          !resource.data.declined_by.hasAll([request.auth.uid])
        )
      );

      // Only the booking customer may delete a ride.
      allow delete: if isAuth()
                    && resource.data.customerId == request.auth.uid;
    }

    // ── Driver locations ──────────────────────────────────────────────────────
    // The driver always reads/writes their own doc. A customer may also read
    // it, but only while `activeRideCustomerId` on the doc names them — the
    // driver app sets that field to match their accepted ride's customer and
    // clears it when the ride ends, so a rider can never read another rider's
    // driver-tracking data.
    match /driver_locations/{driverId} {
      allow read:  if isOwner(driverId) ||
                      (isAuth() && resource.data.activeRideCustomerId == request.auth.uid);
      allow write: if isOwner(driverId);
    }

    // ── Pickup / dropoff suggestions (admin-managed) ──────────────────────────
    match /locations/{locationId} {
      allow read:  if isAuth();
      allow write: if false;
    }

    // ── Orphaned charges (reconciliation) ───────────────────────────────────────
    // Written by the client when a card charge succeeds but ride creation and
    // the automatic refund both fail. Only the charged customer may create one;
    // reviewing/resolving these happens via the Firebase console (Admin SDK),
    // so no client read/update/delete is allowed.
    match /orphanedCharges/{chargeId} {
      allow create: if isAuth() && request.resource.data.customerId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ── Catch-all: deny everything not listed above ───────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}