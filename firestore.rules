rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function rideFieldLengthsOk() {
      let d = request.resource.data;
      return (!('customerName'   in d) || (d.customerName   is string && d.customerName.size()   <= 100)) &&
             (!('customerPhone'  in d) || (d.customerPhone  is string && d.customerPhone.size()  <=  20)) &&
             (!('pickupLocation' in d) || (d.pickupLocation is string && d.pickupLocation.size() <= 200)) &&
             (!('destination'    in d) || (d.destination    is string && d.destination.size()    <= 200));
    }

    function hasVerifiedBankDetails() {
      return get(/databases/$(database)/documents/drivers/$(request.auth.uid))
               .data.bankDetailsVerified == true;
    }

    match /users/{userId} {
      allow read:   if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    match /users/{userId}/walletTransactions/{txnId} {
      allow read:  if isOwner(userId);
      allow write: if false;
    }

    match /drivers/{driverId} {
      allow read:   if isOwner(driverId);
      allow create: if isOwner(driverId);
      // Ratings are written server-side only (POST /api/rides/rate, Admin
      // SDK — bypasses these rules entirely), after verifying the caller
      // actually owns the ride being rated and hasn't rated it before.
      // There used to be a client-side allowance here for exactly the
      // 'ratings' field with no caller-identity or value check at all —
      // any authenticated user (not just customers, not just ones who'd
      // actually ridden with this driver) could overwrite any driver's
      // entire rating history directly via the client SDK. Removed: the
      // real flow never needed it, and it was pure unguarded attack surface.
      allow update: if isOwner(driverId);
      allow delete: if false;
    }

    match /rides/{rideId} {
      allow create: if isAuth()
                    && request.resource.data.customerId == request.auth.uid
                    && rideFieldLengthsOk();

      allow read: if isAuth() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId   == request.auth.uid ||
        (
          resource.data.status == 'pending' &&
          exists(/databases/$(database)/documents/drivers/$(request.auth.uid))
        )
      );

      allow update: if isAuth() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId   == request.auth.uid ||
        (
          resource.data.status == 'pending' &&
          (resource.data.driverId == null || resource.data.driverId == '') &&
          request.resource.data.driverId == request.auth.uid &&
          request.resource.data.status   == 'accepted' &&
          hasVerifiedBankDetails()
        ) ||
        (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['declined_by']) &&
          request.resource.data.declined_by is list &&
          request.resource.data.declined_by.hasAll(resource.data.declined_by) &&
          request.resource.data.declined_by.size() == resource.data.declined_by.size() + 1 &&
          request.resource.data.declined_by.hasAll([request.auth.uid]) &&
          !resource.data.declined_by.hasAll([request.auth.uid])
        )
      );

      allow delete: if isAuth()
                    && resource.data.customerId == request.auth.uid;
    }

    match /driver_locations/{driverId} {
      allow read:  if isOwner(driverId) ||
                      (isAuth() && resource.data.activeRideCustomerId == request.auth.uid);
      allow write: if isOwner(driverId);
    }

    match /locations/{locationId} {
      allow read:  if isAuth();
      allow write: if false;
    }

    match /config/{configId} {
      allow read:  if isAuth();
      allow write: if false;
    }

    match /orphanedCharges/{chargeId} {
      allow create: if isAuth() && request.resource.data.customerId == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /orphanedTopups/{topupId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}