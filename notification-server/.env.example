# Notification Server Environment Variables

# Server Port
PORT=3001

# Expo Access Token (REQUIRED for push notifications)
# Get this from: https://expo.dev/accounts/[your-account]/settings/access-tokens
EXPO_ACCESS_TOKEN=your_expo_access_token_here

# Firebase Admin SDK (automatically loaded from service account JSON file)

# Flutterwave secret key (server-side only — never put this in the mobile app)
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your-key-here

# Shared API key — must match NOTIFICATION_API_KEY in the mobile app .env
# Generate with: openssl rand -hex 32
NOTIFICATION_API_KEY=your-strong-random-secret-here

# Gmail account used to email admins about driver reports (optional — driver
# reports still save to Firestore without these, just without the email alert)
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
ADMIN_EMAIL=kampusrides24@gmail.com

# 'manual' (default) or 'automatic' — see the comment on it in server.js.
# Leave unset (defaults to manual) until Flutterwave's Transfers API IP
# whitelisting is sorted out.
PAYOUT_MODE=manual

# Admin web app (admin-web/) — separate password from NOTIFICATION_API_KEY.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=your-strong-random-admin-secret-here
# Comma-separated browser origins allowed to call /admin-api/* — the deployed
# admin-web URL, plus http://localhost:5173 for local dev.
ADMIN_ALLOWED_ORIGINS=https://your-admin-app.vercel.app,http://localhost:5173
